// Vídeo da seção de prévias: `page_home.video.youtube` aceita a URL (watch, youtu.be, embed,
// shorts) ou o ID. Sem ID válido, a seção mostra a capa com o aviso de "em breve".
const youtubeIdOf = (value: string) => {
  const raw = value.trim()
  if (/^[\w-]{11}$/.test(raw)) return raw
  const match = raw.match(/(?:v=|youtu\.be\/|\/embed\/|\/shorts\/|\/live\/)([\w-]{11})/)
  return match ? match[1] : ''
}
