        <img data-modal-img src="" alt="" />
      </figure>
    </div>

    <script>
      // ── Tema (sincronizado com a docs do Starlight) ─────────────────────────
      const STORAGE_KEY = 'starlight-theme'
      const root = document.documentElement
      const media = window.matchMedia('(prefers-color-scheme: light)')
      const themeBtn = document.querySelector('[data-theme-current]')
      const themeMenu = document.querySelector('[data-theme-menu]')
      const options = Array.from(document.querySelectorAll('[data-theme-option]'))
      const langBtn = document.querySelector('[data-lang-current]')
      const langMenu = document.querySelector('[data-lang-menu]')

      const currentTheme = () => {
        const stored = localStorage.getItem(STORAGE_KEY)
        return stored === 'light' || stored === 'dark'
          ? stored
          : media.matches
            ? 'light'
            : 'dark'
      }

      const render = () => {
        const theme = currentTheme()
        root.dataset.theme = theme
        themeBtn.dataset.mode = localStorage.getItem(STORAGE_KEY) ? theme : 'system'
        options.forEach((opt) => {
          opt.setAttribute('aria-checked', String(opt.dataset.themeOption === theme))
        })
      }

      const setTheme = (value) => {
        if (value === 'system') localStorage.removeItem(STORAGE_KEY)
        else localStorage.setItem(STORAGE_KEY, value)
        render()
      }

      themeBtn.addEventListener('click', () => {
        themeMenu.hidden = !themeMenu.hidden
        if (langMenu) langMenu.hidden = true
      })

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setTheme(opt.dataset.themeOption)
          themeMenu.hidden = true
        })
      })

      langBtn?.addEventListener('click', () => {
        langMenu.hidden = !langMenu.hidden
        themeMenu.hidden = true
      })

      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-theme-toggle]')) themeMenu.hidden = true
        if (!e.target.closest('[data-lang-toggle]') && langMenu) langMenu.hidden = true
        if (!e.target.closest('[data-nav-dropdown]')) {
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((menu) => {
            menu.hidden = true
          })
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          themeMenu.hidden = true
          if (langMenu) langMenu.hidden = true
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((menu) => {
            menu.hidden = true
          })
        }
      })

      document.querySelectorAll('[data-nav-dropdown-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation()
          const menu = trigger.nextElementSibling
          menu.hidden = !menu.hidden
        })
      })

      media.addEventListener('change', render)
      render()

      // ── Carrossel ──────────────────────────────────────────────────────────
      document.querySelectorAll('[data-theme-tabs]').forEach((tabs) => {
        const buttons = Array.from(tabs.querySelectorAll('[data-theme-tab]'))
        const panels = Array.from(tabs.querySelectorAll('[data-theme-panel]'))

        const activate = (category) => {
          buttons.forEach((button) => {
            const active = button.dataset.themeTab === category
            button.classList.toggle('is-active', active)
            button.setAttribute('aria-selected', String(active))
            button.tabIndex = active ? 0 : -1
          })
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.themePanel !== category
            panel.classList.toggle('is-active', !panel.hidden)
          })
        }

        buttons.forEach((button, index) => {
          button.addEventListener('click', () => activate(button.dataset.themeTab))
          button.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return
            event.preventDefault()
            const offset = event.key === 'ArrowRight' ? 1 : -1
            const next = buttons[(index + offset + buttons.length) % buttons.length]
            activate(next.dataset.themeTab)
            next.focus()
          })
        })
      })

      const carousel = document.querySelector('[data-carousel]')
      if (carousel) {
        const track = carousel.querySelector('.carousel-track')
        const slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]'))
        const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'))
        const prev = carousel.querySelector('[data-carousel-prev]')
        const next = carousel.querySelector('[data-carousel-next]')
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        let index = 0
        let timer

        const go = (i) => {
          index = (i + slides.length) % slides.length
          track.style.transform = `translateX(-${index * 100}%)`
          dots.forEach((d, n) => d.setAttribute('aria-current', String(n === index)))
        }

        const stop = () => clearInterval(timer)
        const play = () => {
          stop()
          if (!reduced) timer = setInterval(() => go(index + 1), 5000)
        }

        prev.addEventListener('click', () => {
          go(index - 1)
          play()
        })
        next.addEventListener('click', () => {
          go(index + 1)
          play()
        })
        dots.forEach((d, n) =>
          d.addEventListener('click', () => {
            go(n)
            play()
          }),
        )
        carousel.addEventListener('mouseenter', stop)
        carousel.addEventListener('mouseleave', play)
        carousel.addEventListener('focusin', stop)
        carousel.addEventListener('focusout', play)

        go(0)
        play()
      }

      // ── Reveal ao scroll nas seções ───────────────────────────────────────
      const parallaxEnabled = document.body.dataset.parallaxEnabled === 'true'
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (parallaxEnabled && !prefersReducedMotion) {
        const revealElements = Array.from(document.querySelectorAll('[data-reveal]'))
        const siblingIndex = new Map()
        const parentCount = new Map()

        revealElements.forEach((element) => {
          const parent = element.parentElement
          const index = Math.min(parentCount.get(parent) || 0, 5)
          parentCount.set(parent, (parentCount.get(parent) || 0) + 1)
          siblingIndex.set(element, index)
        })

        const delayOf = new Map()

        revealElements.forEach((element) => {
          let ancestor = element.parentElement
          while (ancestor && !delayOf.has(ancestor)) ancestor = ancestor.parentElement
          const delay = (ancestor ? delayOf.get(ancestor) : 0) + siblingIndex.get(element) * 70
          delayOf.set(element, delay)
          element.style.setProperty('--reveal-delay', `${delay}ms`)
        })

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((element) => element.classList.add('is-revealed'))
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                entry.target.classList.add('is-revealed')
                observer.unobserve(entry.target)
              }
            },
            { rootMargin: '0px 0px -15% 0px', threshold: 0 },
          )

          revealElements.forEach((element) => observer.observe(element))
        }
      }

      // ── Carrossel de apps ─────────────────────────────────────────────────
      document.querySelectorAll('[data-app-carousel]').forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll('.app-carousel-slide'))
        const dots = Array.from(carousel.querySelectorAll('[data-app-carousel-dot]'))
        const prev = carousel.querySelector('[data-app-carousel-prev]')
        const next = carousel.querySelector('[data-app-carousel-next]')
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        let index = 0
        let timer

        const go = (i) => {
          index = (i + slides.length) % slides.length
          slides.forEach((s, n) => s.classList.toggle('active', n === index))
          dots.forEach((d, n) => d.classList.toggle('active', n === index))
        }

        const stop = () => clearInterval(timer)
        const play = () => {
          stop()
          if (!reduced && slides.length > 1) timer = setInterval(() => go(index + 1), 5000)
        }

        prev.addEventListener('click', () => {
          go(index - 1)
          play()
        })
        next.addEventListener('click', () => {
          go(index + 1)
          play()
        })
        dots.forEach((d, n) =>
          d.addEventListener('click', () => {
            go(n)
            play()
          }),
        )
        carousel.addEventListener('mouseenter', stop)
        carousel.addEventListener('mouseleave', play)

        go(0)
        if (slides.length > 1) play()
      })

      // ── Modal em tela cheia ────────────────────────────────────────────────
      const modal = document.querySelector('[data-modal]')
      const modalImg = document.querySelector('[data-modal-img]')
      const modalClose = document.querySelector('[data-modal-close]')

      const openModal = (img) => {
        modalImg.src = img.currentSrc || img.src
        modalImg.alt = img.alt
        modal.hidden = false
        modal.setAttribute('aria-hidden', 'false')
        document.body.style.overflow = 'hidden'
        modalClose.focus()
      }

      const closeModal = () => {
        modal.hidden = true
        modal.setAttribute('aria-hidden', 'true')
        document.body.style.overflow = ''
      }

      const bindPreview = (el) => {
        el.addEventListener('click', () => openModal(el.querySelector('img')))
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            openModal(el.querySelector('img'))
          }
        })
      }

      document.querySelectorAll('[data-carousel-slide]').forEach(bindPreview)
      document.querySelectorAll('[data-preview]').forEach(bindPreview)

      modalClose.addEventListener('click', closeModal)
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal()
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal()
      })

      // ── About animation ──────────────────────────────────────────────────
      const aboutEl = document.querySelector('[data-about-animate]')
      if (aboutEl) {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        if (prefersReduced) {
          aboutEl.classList.add('is-visible')
        } else {
          const observer = new IntersectionObserver(
            ([entry]) => {
              if (entry.isIntersecting) {
                aboutEl.classList.add('is-visible')
                observer.unobserve(aboutEl)
              }
            },
            { threshold: 0.3 },
          )
          observer.observe(aboutEl)
        }
      }

      // ── About pronunciation ─────────────────────────────────────────────
      const pronunciationSelect = document.querySelector('[data-pronunciation-select]')
      const pronunciationAudio = document.querySelector('[data-pronunciation-audio]')
      if (pronunciationSelect && pronunciationAudio) {
        pronunciationSelect.addEventListener('change', () => {
          const wasPlaying = !pronunciationAudio.paused
          pronunciationAudio.src = pronunciationSelect.value
          pronunciationAudio.load()
          if (wasPlaying) pronunciationAudio.play().catch(() => {})
        })
      }

      // ── Support / Contribution ────────────────────────────────────────────
      const supportAmounts = Array.from(document.querySelectorAll('[data-amount]'))
      const supportBtn = document.querySelector('[data-support-btn]')
      let selectedLink = null

      supportAmounts.forEach((btn) => {
        btn.addEventListener('click', () => {
          supportAmounts.forEach((b) => {
            b.classList.remove('is-selected')
            b.setAttribute('aria-pressed', 'false')
          })
          btn.classList.add('is-selected')
          btn.setAttribute('aria-pressed', 'true')
          selectedLink = btn.dataset.link
          supportBtn.disabled = false
        })
      })

      supportBtn?.addEventListener('click', () => {
        if (selectedLink && !selectedLink.startsWith('STRIPE_')) {
          window.location.href = selectedLink
        }
      })

      // ── PayPal currency toggle ──────────────────────────────────────────
      const currencyToggle = document.querySelector('[data-currency-toggle]')
      const paypalBtn = document.querySelector('[data-paypal-btn]')
      const currencyLabels = Array.from(document.querySelectorAll('[data-currency-label]'))
      let currentCurrency = 'USD'

      const updatePaypalCurrency = () => {
        if (paypalBtn && currencyToggle) {
          paypalBtn.href = currentCurrency === 'USD'
            ? currencyToggle.dataset.usd
            : currencyToggle.dataset.brl
        }
        currencyLabels.forEach((label) => {
          label.classList.toggle('is-active', label.dataset.currencyLabel === currentCurrency)
        })
      }

      currencyToggle?.addEventListener('click', () => {
        currentCurrency = currentCurrency === 'USD' ? 'BRL' : 'USD'
        currencyToggle.setAttribute('aria-checked', String(currentCurrency === 'BRL'))
        updatePaypalCurrency()
      })

      updatePaypalCurrency()
    </script>

    <script is:inline>
      // Terminal Effects para o Hero
      class HeroTerminalEffects {
        constructor() {
          this.heroSection = document.querySelector('.hero')
          if (!this.heroSection) return

          this.h1 = this.heroSection.querySelector('h1')
          this.badges = Array.from(this.heroSection.querySelectorAll('.hero-badge'))
          this.prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches

          if (!this.prefersReducedMotion) {
            this.init()
          }
        }

        init() {
          this.addTypingEffect()
          this.addBadgeAnimations()
          this.addHoverEffects()
        }

        addTypingEffect() {
          if (!this.h1) return

          const originalText = this.h1.textContent
          const accentElement = this.h1.querySelector('.accent')
          const accentText = accentElement ? accentElement.textContent : ''
          const baseText = originalText.replace(accentText, '').trim()

          this.h1.innerHTML = ''
          this.h1.style.opacity = '1'

          const cursor = document.createElement('span')
          cursor.className = 'hero-cursor'
          cursor.textContent = '_'
          cursor.style.cssText = `
            display: inline-block;
            animation: hero-cursor-blink 0.6s infinite;
            margin-left: 2px;
            color: var(--lp-accent);
          `

          const typeText = async () => {
            const characters = baseText.split('')

            for (const char of characters) {
              const span = document.createElement('span')
              span.textContent = char
              span.style.cssText = 'opacity: 1; animation: hero-char-appear 0.05s ease-out;'
              this.h1.insertBefore(span, cursor)
              await this.delay(40)
            }

            const br = document.createElement('br')
            this.h1.insertBefore(br, cursor)
            await this.delay(200)

            const accentSpan = document.createElement('span')
            accentSpan.className = 'accent'
            accentSpan.style.cssText = 'display: block; opacity: 1;'

            const accentChars = accentText.split('')
            for (const char of accentChars) {
              const span = document.createElement('span')
              span.textContent = char
              span.style.cssText =
                'opacity: 1; animation: hero-char-appear 0.05s ease-out;'
              accentSpan.appendChild(span)
              await this.delay(40)
            }

            this.h1.insertBefore(accentSpan, cursor)
            await this.delay(300)

            cursor.style.animation = 'none'
            cursor.style.opacity = '0'
          }

          this.h1.appendChild(cursor)
          typeText()
        }

        addBadgeAnimations() {
          if (this.badges.length === 0) return

          this.badges.forEach((badge, index) => {
            badge.style.cssText = `
              opacity: 0;
              transform: translateY(8px) translateX(-2px);
              animation: hero-badge-appear 0.4s ease-out forwards;
              animation-delay: ${0.4 + index * 0.08}s;
            `
          })
        }

        addHoverEffects() {
          const buttons = this.heroSection.querySelectorAll('.btn')
          buttons.forEach((btn) => {
            btn.addEventListener('mouseenter', (e) => {
              const rect = btn.getBoundingClientRect()
              const x = e.clientX - rect.left
              const y = e.clientY - rect.top

              btn.style.cssText += `
                --mouse-x: ${x}px;
                --mouse-y: ${y}px;
              `

              btn.classList.add('hero-btn-active')
            })

            btn.addEventListener('mouseleave', () => {
              btn.classList.remove('hero-btn-active')
            })
          })
        }

        delay(ms) {
          return new Promise((resolve) => setTimeout(resolve, ms))
        }
      }


      // Glitch Effect para H2 das Sections
      class SectionHeadingsGlitch {
        constructor() {
          this.headings = Array.from(document.querySelectorAll('.section-head h2'))
          this.prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches

          if (!this.prefersReducedMotion && this.headings.length > 0) {
            this.init()
          }
        }

        init() {
          this.headings.forEach((heading) => {
            heading.addEventListener('mouseenter', () => this.glitchHeading(heading))
          })
        }

        glitchHeading(heading) {
          if (heading.dataset.glitching === 'true') return

          heading.dataset.glitching = 'true'
          const originalText = heading.textContent

          const glitchChars = ['<', '>', '|', '/', '\\', '~', '^', '[', ']', '{', '}']
          const iterations = 8

          let count = 0
          const glitchInterval = setInterval(() => {
            if (count >= iterations) {
              heading.textContent = originalText
              heading.dataset.glitching = 'false'
              clearInterval(glitchInterval)
              return
            }

            const randomText = originalText
              .split('')
              .map((char) => {
                if (Math.random() > 0.7) {
                  return glitchChars[Math.floor(Math.random() * glitchChars.length)]
                }
                return char
              })
              .join('')

            heading.textContent = randomText
            count++
          }, 60)
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          new HeroTerminalEffects()
          new SectionHeadingsGlitch()
        })
      } else {
        new HeroTerminalEffects()
        new SectionHeadingsGlitch()
      }
    </script>
  </body>
</html>
