    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'ARGVUS',
      applicationCategory: 'DesktopApplication',
      operatingSystem: 'Arch Linux',
      url: siteUrl,
      codeRepository: githubOrgUrl,
      description: t.description,
      keywords: t.keywords,
    })} />
    <script is:inline>
      // Aplica o tema antes do primeiro paint, sincronizado com a docs (chave do Starlight).
      ;(function () {
        var key = 'starlight-theme'
        var stored = localStorage.getItem(key)
        var light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : light
              ? 'light'
              : 'dark'
      })()
    </script>
    <noscript>
      <style>
        body[data-parallax-enabled='true'] [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      </style>
    </noscript>
  </head>
