import fs from 'node:fs'
import { resolve } from 'node:path'
import siteConfig from '../site-config.json'

const { version } = JSON.parse(
  fs.readFileSync(resolve(process.cwd(), 'version.json'), 'utf8'),
)
const isBeta = version.startsWith('0.')

interface Props {
  lang: 'en' | 'pt'
}

const { lang } = Astro.props
const base = import.meta.env.BASE_URL
const isPT = lang === 'pt'
const siteUrl = 'https://argvus.github.io'
const githubOrgUrl = 'https://github.com/orgs/argvus'
const logotypeUrl =
  'https://raw.githubusercontent.com/argvus/argvus-logo/refs/heads/main/svg/ARGVUS-logo.svg'
const argvusWordmarkUrl =
  'https://raw.githubusercontent.com/argvus/argvus-logo/refs/heads/main/svg/ARGVUS-wordmark.svg'

const link = (path: string) =>
  base + (isPT && !path.startsWith('packages/') ? 'pt/' : '') + path

const initialPronunciation = isPT ? argvusPronunciationPt : argvusPronunciationEn

