    <script>
      // ── Tema (sincronizado com a docs do Starlight) ─────────────────────────
      const STORAGE_KEY = 'starlight-theme'
      const root = document.documentElement
      const media = window.matchMedia('(prefers-color-scheme: light)')
      const themeBtn = document.querySelector('[data-theme-current]')
      const themeMenu = document.querySelector('[data-theme-menu]')
      const options = Array.from(document.querySelectorAll('[data-theme-option]'))
      const langBtn = document.querySelector('[data-lang-current]')
      const langMenu = document.querySelector('[data-lang-menu]')

      const currentTheme = () => {
        const stored = localStorage.getItem(STORAGE_KEY)
        return stored === 'light' || stored === 'dark'
          ? stored
          : media.matches
            ? 'light'
            : 'dark'
      }

      const render = () => {
        const theme = currentTheme()
        root.dataset.theme = theme
        themeBtn.dataset.mode = localStorage.getItem(STORAGE_KEY) ? theme : 'system'
        options.forEach((opt) => {
          opt.setAttribute('aria-checked', String(opt.dataset.themeOption === theme))
        })
      }

      const setTheme = (value) => {
        if (value === 'system') localStorage.removeItem(STORAGE_KEY)
        else localStorage.setItem(STORAGE_KEY, value)
        render()
      }

      themeBtn.addEventListener('click', () => {
        themeMenu.hidden = !themeMenu.hidden
        if (langMenu) langMenu.hidden = true
      })

      options.forEach((opt) => {
        opt.addEventListener('click', () => {
          setTheme(opt.dataset.themeOption)
          themeMenu.hidden = true
        })
      })

      langBtn?.addEventListener('click', () => {
        langMenu.hidden = !langMenu.hidden
        themeMenu.hidden = true
      })

      document.addEventListener('click', (e) => {
        if (!e.target.closest('[data-theme-toggle]')) themeMenu.hidden = true
        if (!e.target.closest('[data-lang-toggle]') && langMenu) langMenu.hidden = true
        if (!e.target.closest('[data-nav-dropdown]')) {
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((menu) => {
            menu.hidden = true
          })
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          themeMenu.hidden = true
          if (langMenu) langMenu.hidden = true
          document.querySelectorAll('[data-nav-dropdown-menu]').forEach((menu) => {
            menu.hidden = true
          })
        }
      })

      document.querySelectorAll('[data-nav-dropdown-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation()
          const menu = trigger.nextElementSibling
          menu.hidden = !menu.hidden
        })
      })

      media.addEventListener('change', render)
      render()

      // ── Menu móvel: abaixo de 860px os links viram um painel sob o header ──
      const siteNav = document.querySelector('[data-site-nav]')
      const navMenuButton = document.querySelector('[data-nav-menu]')
      const setNavMenu = (open) => {
        siteNav.toggleAttribute('data-menu-open', open)
        navMenuButton.setAttribute('aria-expanded', String(open))
      }
      navMenuButton.addEventListener('click', (event) => {
        event.stopPropagation()
        setNavMenu(!siteNav.hasAttribute('data-menu-open'))
      })
      siteNav.querySelectorAll('.nav-links a').forEach((anchor) => anchor.addEventListener('click', () => setNavMenu(false)))
      document.addEventListener('click', (event) => {
        if (!event.target.closest('#site-nav-links')) setNavMenu(false)
      })
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && siteNav.hasAttribute('data-menu-open')) {
          setNavMenu(false)
          navMenuButton.focus()
        }
      })

      // ── Header: borda e fundo sólido só depois de rolar ────────────────────
      const siteHeader = document.querySelector('.site-header')
      const markScrolled = () => siteHeader.toggleAttribute('data-scrolled', window.scrollY > 8)
      window.addEventListener('scroll', markScrolled, { passive: true })
      markScrolled()

      // ── Copiar o comando de instalação do hero ────────────────────────────
      document.querySelectorAll('[data-copy]').forEach((button) => {
        const label = button.getAttribute('aria-label')
        const icon = button.querySelector('i')
        const setIcon = (copied) => {
          icon.classList.toggle('fa-regular', !copied)
          icon.classList.toggle('fa-copy', !copied)
          icon.classList.toggle('fa-solid', copied)
          icon.classList.toggle('fa-check', copied)
        }
        let reset
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy)
          } catch {
            return
          }
          clearTimeout(reset)
          button.classList.add('is-copied')
          setIcon(true)
          button.setAttribute('aria-label', button.dataset.copiedLabel)
          button.title = button.dataset.copiedLabel
          reset = setTimeout(() => {
            button.classList.remove('is-copied')
            setIcon(false)
            button.setAttribute('aria-label', label)
            button.title = label
          }, 1600)
        })
      })

      // ── Réplica do Control Center: navegação dos passos da instalação avançada ──
      const cc = document.querySelector('[data-cc]')
      if (cc) {
        const columns = Array.from(cc.querySelectorAll('[data-cc-card]'), (card) =>
          Array.from(card.querySelectorAll('[data-cc-item]')),
        )
        const items = columns.flat()
        const commandEl = cc.querySelector('[data-cc-command]')
        const noteEl = cc.querySelector('[data-cc-note]')
        const statusEl = cc.querySelector('[data-cc-status]')
        const copyButton = cc.querySelector('[data-cc-copy]')
        const copyAllButton = cc.querySelector('[data-cc-copy-all]')
        let current = items[0]
        let statusTimer
        let demo

        const select = (item, focus = false) => {
          current = item
          items.forEach((el) => {
            el.tabIndex = el === item ? 0 : -1
            if (el === item) el.setAttribute('aria-current', 'true')
            else el.removeAttribute('aria-current')
          })
          cc.querySelectorAll('[data-cc-card]').forEach((card) => card.classList.toggle('is-active', card.contains(item)))
          const command = item.dataset.command
          commandEl.textContent = command || cc.dataset.noCommand
          commandEl.parentElement.classList.toggle('is-empty', !command)
          noteEl.textContent = item.dataset.note
          copyButton.disabled = !command
          if (focus) item.focus()
        }

        // Status à esquerda do rodapé, como o draw_footer do Control Center.
        const copy = async (text, message) => {
          if (!text) return
          try {
            await navigator.clipboard.writeText(text)
          } catch {
            return
          }
          clearTimeout(statusTimer)
          statusEl.textContent = `✓ ${message}`
          statusTimer = setTimeout(() => {
            statusEl.textContent = ''
          }, 1600)
        }
        const copyCurrent = () => copy(current.dataset.command, cc.dataset.copied)
        const copyAll = () => copy(cc.dataset.allCommands, cc.dataset.copiedAll)
        const stopDemo = () => clearInterval(demo)

        items.forEach((item) =>
          item.addEventListener('click', () => {
            stopDemo()
            select(item)
          }),
        )
        copyButton.addEventListener('click', copyCurrent)
        copyAllButton.addEventListener('click', copyAll)

        // ↑/↓ itens do passo, ←/→ passos, Home/End, Enter copia, c copia tudo.
        cc.addEventListener('keydown', (event) => {
          if (!event.target.matches('[data-cc-item]') || event.metaKey || event.ctrlKey || event.altKey) return
          let col = columns.findIndex((column) => column.includes(current))
          let row = columns[col].indexOf(current)
          switch (event.key) {
            case 'ArrowDown':
              row = Math.min(row + 1, columns[col].length - 1)
              break
            case 'ArrowUp':
              row = Math.max(row - 1, 0)
              break
            case 'ArrowRight':
              col = Math.min(col + 1, columns.length - 1)
              row = Math.min(row, columns[col].length - 1)
              break
            case 'ArrowLeft':
              col = Math.max(col - 1, 0)
              row = Math.min(row, columns[col].length - 1)
              break
            case 'Home':
              col = 0
              row = 0
              break
            case 'End':
              col = columns.length - 1
              row = columns[col].length - 1
              break
            case 'Enter':
              event.preventDefault()
              copyCurrent()
              return
            case 'c':
            case 'C':
              event.preventDefault()
              copyAll()
              return
            default:
              return
          }
          event.preventDefault()
          stopDemo()
          select(columns[col][row], true)
        })

        // Demonstração: a seleção percorre os itens enquanto ninguém interage com a réplica.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
          let visible = false
          new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting
          }, { threshold: 0.4 }).observe(cc)
          demo = setInterval(() => {
            if (visible) select(items[(items.indexOf(current) + 1) % items.length])
          }, 2800)
          cc.addEventListener('pointerenter', stopDemo, { once: true })
          cc.addEventListener('focusin', stopDemo, { once: true })
        }
      }

      // ── Abas de temas (Dark/Light) ─────────────────────────────────────────
      document.querySelectorAll('[data-theme-tabs]').forEach((tabs) => {
        const buttons = Array.from(tabs.querySelectorAll('[data-theme-tab]'))
        const panels = Array.from(tabs.querySelectorAll('[data-theme-panel]'))

        const activate = (category) => {
          buttons.forEach((button) => {
            const active = button.dataset.themeTab === category
            button.classList.toggle('is-active', active)
            button.setAttribute('aria-selected', String(active))
            button.tabIndex = active ? 0 : -1
          })
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.themePanel !== category
            panel.classList.toggle('is-active', !panel.hidden)
          })
        }

        buttons.forEach((button, index) => {
          button.addEventListener('click', () => activate(button.dataset.themeTab))
          button.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return
            event.preventDefault()
            const offset = event.key === 'ArrowRight' ? 1 : -1
            const next = buttons[(index + offset + buttons.length) % buttons.length]
            activate(next.dataset.themeTab)
            next.focus()
          })
        })
      })

      // ── Vídeo: troca a capa pelo player do YouTube (youtube-nocookie) no clique ──
      document.querySelectorAll('[data-video]').forEach((frame) => {
        frame.querySelector('[data-video-play]')?.addEventListener('click', (event) => {
          event.preventDefault()
          const player = document.createElement('iframe')
          player.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.video}?autoplay=1&rel=0`
          player.title = frame.dataset.videoTitle
          player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
          player.allowFullscreen = true
          player.referrerPolicy = 'strict-origin-when-cross-origin'
          frame.replaceChildren(player)
          player.focus()
        })
      })

      // ── Keycaps: fixas no trilho direito; ao chegar na seção, ocupam o eyebrow ──
      const keyRail = document.querySelector('[data-hero-keycaps]')
      const keySlots = document.querySelectorAll('[data-keycap-slot]')
      if (keyRail && keySlots.length) {
        const railCaps = Array.from(keyRail.querySelectorAll('.keycap[data-target]'))
        // Abaixo desta largura não há margem livre: cada tecla fica direto no seu eyebrow.
        const narrow = window.matchMedia('(max-width: 1399px)')
        const still = window.matchMedia('(prefers-reduced-motion: reduce)')
        const slotOf = (cap) => document.querySelector(`[data-keycap-slot="${cap.dataset.target}"]`)

        // FLIP: mede antes, troca de pai e anima do ponto antigo até o novo.
        const move = (cap, parent, before = null) => {
          const first = cap.getBoundingClientRect()
          parent.insertBefore(cap, before)
          if (still.matches || !first.width) return
          const last = cap.getBoundingClientRect()
          cap.animate(
            [{ translate: `${first.left - last.left}px ${first.top - last.top}px` }, { translate: '0 0' }],
            { duration: 650, easing: 'cubic-bezier(0.2, 0.9, 0.25, 1)' },
          )
        }

        let ticking = false
        const place = () => {
          ticking = false
          railCaps.forEach((cap, i) => {
            const slot = slotOf(cap)
            const sec = document.getElementById(cap.dataset.target)
            if (!slot || !sec) return
            const reached = narrow.matches || sec.getBoundingClientRect().top <= window.innerHeight * 0.5
            if (reached && cap.parentElement !== slot) {
              move(cap, slot)
            } else if (!reached && cap.parentElement !== keyRail) {
              // Volta ao trilho mantendo a ordem original (ordem de tabulação).
              const next = railCaps.slice(i + 1).find((c) => c.parentElement === keyRail) || null
              move(cap, keyRail, next)
            }
          })
        }
        const schedule = () => {
          if (!ticking) {
            ticking = true
            requestAnimationFrame(place)
          }
        }
        window.addEventListener('scroll', schedule, { passive: true })
        window.addEventListener('resize', schedule)
        narrow.addEventListener('change', schedule)
        place()
      }

      // ── Efeitos de DNA: teclado, tilt + spotlight, scramble e spotlight do hero ──
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const body = document.body
        const caps = Array.from(document.querySelectorAll('.keycap[data-key]'))

        if (body.dataset.keyboardEnabled === 'true' && caps.length) {
          const press = (key) => {
            caps.forEach((cap) => {
              if (cap.dataset.key.toLowerCase() === key.toLowerCase()) {
                cap.classList.add('is-pressed')
                setTimeout(() => cap.classList.remove('is-pressed'), 160)
              }
            })
          }
          window.addEventListener('keydown', (event) => {
            if (event.metaKey || event.ctrlKey || event.altKey) return
            press(event.key)
          })
        }

        if (body.dataset.tiltEnabled === 'true' && window.matchMedia('(hover: hover)').matches) {
          document.querySelectorAll('.feature-card').forEach((el) => {
            el.classList.add('has-tilt')
            el.addEventListener('pointermove', (event) => {
              const r = el.getBoundingClientRect()
              const x = (event.clientX - r.left) / r.width - 0.5
              const y = (event.clientY - r.top) / r.height - 0.5
              el.style.setProperty('--tilt-x', `${(-y * 3).toFixed(2)}deg`)
              el.style.setProperty('--tilt-y', `${(x * 3).toFixed(2)}deg`)
              // Posição do ponteiro para o spotlight radial do card.
              el.style.setProperty('--px', `${(event.clientX - r.left).toFixed(0)}px`)
              el.style.setProperty('--py', `${(event.clientY - r.top).toFixed(0)}px`)
            })
            el.addEventListener('pointerleave', () => {
              el.style.setProperty('--tilt-x', '0deg')
              el.style.setProperty('--tilt-y', '0deg')
            })
          })
        }

        const navCaps = Array.from(document.querySelectorAll('.keycap[data-target]'))
        if (navCaps.length && 'IntersectionObserver' in window) {
          const secObs = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return
                navCaps.forEach((cap) => cap.classList.toggle('is-active', cap.dataset.target === entry.target.id))
              })
            },
            { rootMargin: '-40% 0px -55% 0px' },
          )
          navCaps.forEach((cap) => {
            const sec = document.getElementById(cap.dataset.target)
            if (sec) secObs.observe(sec)
          })
        }

        // Títulos de seção: no hover os caracteres se resolvem da esquerda para a direita.
        const glyphs = '<>/\\|[]{}_=+*#'
        document.querySelectorAll('.section-head h2').forEach((heading) => {
          const text = heading.textContent
          let running = false
          heading.addEventListener('mouseenter', () => {
            if (running) return
            running = true
            heading.style.minHeight = `${heading.offsetHeight}px`
            const start = performance.now()
            const frame = (now) => {
              const progress = Math.min((now - start) / 450, 1)
              const resolved = Math.floor(progress * text.length)
              heading.textContent = Array.from(text, (char, i) =>
                i < resolved || char === ' ' ? char : glyphs[Math.floor(Math.random() * glyphs.length)],
              ).join('')
              if (progress < 1) {
                requestAnimationFrame(frame)
                return
              }
              heading.textContent = text
              heading.style.minHeight = ''
              running = false
            }
            requestAnimationFrame(frame)
          })
        })

        // Hero: o brilho de fundo acompanha o ponteiro.
        const heroEl = document.querySelector('[data-hero]')
        if (heroEl && window.matchMedia('(hover: hover)').matches) {
          heroEl.addEventListener('pointermove', (event) => {
            const r = heroEl.getBoundingClientRect()
            heroEl.style.setProperty('--mx', ((event.clientX - r.left) / r.width - 0.5).toFixed(3))
            heroEl.style.setProperty('--my', ((event.clientY - r.top) / r.height - 0.5).toFixed(3))
          })
        }
      }

      // ── Reveal ao scroll nas seções ───────────────────────────────────────
      const parallaxEnabled = document.body.dataset.parallaxEnabled === 'true'
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (parallaxEnabled && !prefersReducedMotion) {
        const revealElements = Array.from(document.querySelectorAll('[data-reveal]'))
        const siblingIndex = new Map()
        const parentCount = new Map()

        revealElements.forEach((element) => {
          const parent = element.parentElement
          const index = Math.min(parentCount.get(parent) || 0, 5)
          parentCount.set(parent, (parentCount.get(parent) || 0) + 1)
          siblingIndex.set(element, index)
        })

        const delayOf = new Map()

        revealElements.forEach((element) => {
          let ancestor = element.parentElement
          while (ancestor && !delayOf.has(ancestor)) ancestor = ancestor.parentElement
          const delay = (ancestor ? delayOf.get(ancestor) : 0) + siblingIndex.get(element) * 70
          delayOf.set(element, delay)
          element.style.setProperty('--reveal-delay', `${delay}ms`)
        })

        if (!('IntersectionObserver' in window)) {
          revealElements.forEach((element) => element.classList.add('is-revealed'))
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                entry.target.classList.add('is-revealed')
                observer.unobserve(entry.target)
              }
            },
            { rootMargin: '0px 0px -15% 0px', threshold: 0 },
          )

          revealElements.forEach((element) => observer.observe(element))
        }
      }

      // ── Carrossel de apps ─────────────────────────────────────────────────
      document.querySelectorAll('[data-app-carousel]').forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll('.app-carousel-slide'))
        const dots = Array.from(carousel.querySelectorAll('[data-app-carousel-dot]'))
        const prev = carousel.querySelector('[data-app-carousel-prev]')
        const next = carousel.querySelector('[data-app-carousel-next]')
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        let index = 0
        let timer

        const go = (i) => {
          index = (i + slides.length) % slides.length
          slides.forEach((s, n) => s.classList.toggle('active', n === index))
          dots.forEach((d, n) => d.classList.toggle('active', n === index))
        }

        const stop = () => clearInterval(timer)
        const play = () => {
          stop()
          if (!reduced && slides.length > 1) timer = setInterval(() => go(index + 1), 5000)
        }

        prev.addEventListener('click', () => {
          go(index - 1)
          play()
        })
        next.addEventListener('click', () => {
          go(index + 1)
          play()
        })
        dots.forEach((d, n) =>
          d.addEventListener('click', () => {
            go(n)
            play()
          }),
        )
        carousel.addEventListener('mouseenter', stop)
        carousel.addEventListener('mouseleave', play)

        go(0)
        if (slides.length > 1) play()
      })

      // ── Modal em tela cheia ────────────────────────────────────────────────
      const modal = document.querySelector('[data-modal]')
      const modalImg = document.querySelector('[data-modal-img]')
      const modalClose = document.querySelector('[data-modal-close]')

      const openModal = (img) => {
        modalImg.src = img.currentSrc || img.src
        modalImg.alt = img.alt
        modal.hidden = false
        modal.setAttribute('aria-hidden', 'false')
        document.body.style.overflow = 'hidden'
        modalClose.focus()
      }

      const closeModal = () => {
        modal.hidden = true
        modal.setAttribute('aria-hidden', 'true')
        document.body.style.overflow = ''
      }

      const bindPreview = (el) => {
        el.addEventListener('click', () => openModal(el.querySelector('img')))
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            openModal(el.querySelector('img'))
          }
        })
      }

      document.querySelectorAll('[data-preview]').forEach(bindPreview)

      modalClose.addEventListener('click', closeModal)
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal()
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal()
      })

      // ── Support / Contribution ────────────────────────────────────────────
      const supportAmounts = Array.from(document.querySelectorAll('[data-amount]'))
      const supportBtn = document.querySelector('[data-support-btn]')
      let selectedLink = null

      supportAmounts.forEach((btn) => {
        btn.addEventListener('click', () => {
          supportAmounts.forEach((b) => {
            b.classList.remove('is-selected')
            b.setAttribute('aria-pressed', 'false')
          })
          btn.classList.add('is-selected')
          btn.setAttribute('aria-pressed', 'true')
          selectedLink = btn.dataset.link
          supportBtn.disabled = false
        })
      })

      supportBtn?.addEventListener('click', () => {
        if (selectedLink && !selectedLink.startsWith('STRIPE_')) {
          window.location.href = selectedLink
        }
      })

      // ── PayPal currency toggle ──────────────────────────────────────────
      const currencyToggle = document.querySelector('[data-currency-toggle]')
      const paypalBtn = document.querySelector('[data-paypal-btn]')
      let currentCurrency = 'USD'

      const updatePaypalCurrency = () => {
        if (paypalBtn && currencyToggle) {
          paypalBtn.href = currentCurrency === 'USD'
            ? currencyToggle.dataset.usd
            : currencyToggle.dataset.brl
        }
        if (currencyToggle) {
          currencyToggle.querySelector('[data-currency-symbol]').textContent = currentCurrency === 'USD' ? '$' : 'R$'
        }
      }

      currencyToggle?.addEventListener('click', () => {
        currentCurrency = currentCurrency === 'USD' ? 'BRL' : 'USD'
        currencyToggle.setAttribute('aria-checked', String(currentCurrency === 'BRL'))
        updatePaypalCurrency()
      })

      updatePaypalCurrency()
    </script>
  </body>
</html>
