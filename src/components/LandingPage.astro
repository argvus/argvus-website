// Instalação avançada na réplica do Control Center: passos (cards) e itens com o comando literal.
// Os comandos são os mesmos de repo-install.sh/install.sh, escritos para execução manual.
const ccSteps = [
  {
    id: 'key',
    icon: 'fa-solid fa-key',
    items: [
      { id: 'download', command: 'curl -fsSLo /tmp/argvus.gpg https://argvus.github.io/packages/arch/argvus.gpg' },
      { id: 'import', command: 'sudo pacman-key --add /tmp/argvus.gpg' },
      { id: 'keyId', command: `ARGVUS_KEY="$(gpg --show-keys --with-colons /tmp/argvus.gpg | grep '^pub:' | head -n1 | cut -d: -f5)"` },
      { id: 'sign', command: 'sudo pacman-key --lsign-key "$ARGVUS_KEY"' },
    ],
  },
  {
    id: 'repo',
    icon: 'fa-solid fa-box-archive',
    items: [
      { id: 'conf', command: 'curl -fsSL https://argvus.github.io/packages/arch/argvus.conf | sudo tee /etc/pacman.d/argvus.conf' },
      { id: 'include', command: 'echo "Include = /etc/pacman.d/argvus.conf" | sudo tee -a /etc/pacman.conf' },
    ],
  },
  {
    id: 'install',
    icon: 'fa-solid fa-download',
    items: [
      { id: 'pacman', command: t.installCmd },
      { id: 'session', command: '' },
    ],
  },
] as const
const ccAllCommands = ccSteps
  .flatMap((step) => step.items.map((item) => item.command))
  .filter(Boolean)
  .join('\n')
const ccFirst = ccSteps[0].items[0]
