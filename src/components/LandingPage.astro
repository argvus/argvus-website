  { name: 'ARGVUS Dark', image: previewThemeArgvusDarkImage },
  { name: 'ARGVUS Dark — Float', image: previewThemeDarkFloatImage },
  { name: 'Silver Dark', image: previewThemeDarkSilverImage },
  { name: 'Silver Dark — Float', image: previewThemeDarkSilverFloatImage },
  { name: 'Slate Dark', image: previewThemeDarkSlateImage },
  { name: 'Slate Dark — Float', image: previewThemeDarkSlateFloatImage },
  { name: 'Universe', image: previewThemeDarkUniverseImage },
  { name: 'Universe — Float', image: previewThemeDarkUniverseFloatImage },
  { name: 'ARGVUS Light', image: previewThemeArgvusLightImage },
  { name: 'ARGVUS Light — Float', image: previewThemeArgvusLightFloatImage },
  {
    name: 'Taskbar at the bottom',
    image: previewThemeArgvusDarkTaskbarBottomImage,
    alt: isPT
      ? 'ARGVUS desktop com a barra de tarefas embaixo'
      : 'ARGVUS desktop with the taskbar at the bottom',
  },
]

const components = [
  { key: 'hyprland', name: 'Hyprland' },
  { key: 'waybar', name: 'Waybar' },
  { key: 'quickshell', name: 'Quickshell' },
  { key: 'rofi', name: 'Rofi' },
  { key: 'superfile', name: 'superfile' },
  { key: 'btop', name: 'btop' },
  { key: 'hyprlock', name: 'hyprlock' },
  { key: 'storage', name: 'ARGVUS Removable Devices' },
]

const themes = [
  { name: 'Dracula', shortName: 'Dracula', id: 'dracula', category: 'dark', foreground: '#BD93F9', background: '#282A36', default: true },
  { name: 'Gruvbox Dark', shortName: 'Gruvbox Dark', id: 'gruvbox-dark', category: 'dark', foreground: '#D4BE98', background: '#282828' },
  { name: 'Gruvbox High Dark', shortName: 'Gruvbox High Dark', id: 'gruvbox-high-dark', category: 'dark', foreground: '#D4BE98', background: '#282828' },
  { name: 'Hackerman', shortName: 'Hackerman', id: 'hackerman', category: 'dark', foreground: '#82FB9C', background: '#0B0C16' },
  { name: 'Monokai Dark', shortName: 'Monokai Dark', id: 'monokai-dark', category: 'dark', foreground: '#78DCE8', background: '#2D2A2E' },
  { name: 'One Dark', shortName: 'One Dark', id: 'one-dark', category: 'dark', foreground: '#61AFEF', background: '#282C34' },
  { name: 'Rosé Pine', shortName: 'Rosé Pine', id: 'rose-pine', category: 'dark', foreground: '#C4A7E7', background: '#191724' },
  { name: 'Silver Dark', shortName: 'Silver Dark', id: 'silver-dark', category: 'dark', foreground: '#595959', background: '#111316' },
  { name: 'Slate Dark', shortName: 'Slate Dark', id: 'slate-dark', category: 'dark', foreground: '#7391A5', background: '#2F3541' },
  { name: 'Solitude', shortName: 'Solitude', id: 'solitude', category: 'dark', foreground: '#798186', background: '#101315' },
  { name: 'Sunset', shortName: 'Sunset', id: 'sunset', category: 'dark', foreground: '#E2BE8A', background: '#0F0F0F' },
  { name: 'Tokyo Night', shortName: 'Tokyo Night', id: 'tokyo-night', category: 'dark', foreground: '#7AA2F7', background: '#1A1B26' },
  { name: 'Universe', shortName: 'Universe', id: 'universe', category: 'dark', foreground: '#EEEEEE', background: '#000000' },
  { name: 'Catppuccin Latte', shortName: 'Catppuccin Latte', id: 'catppuccin-latte', category: 'light', foreground: '#1E66F5', background: '#EFF1F5' },
  { name: 'Everforest Light', shortName: 'Everforest Light', id: 'everforest-light', category: 'light', foreground: '#3A94C5', background: '#FDF6E3' },
  { name: 'GitHub Light', shortName: 'GitHub Light', id: 'github-light', category: 'light', foreground: '#0969DA', background: '#FFFFFF' },
  { name: 'Gruvbox Light', shortName: 'Gruvbox Light', id: 'gruvbox-light', category: 'light', foreground: '#458588', background: '#FBF1C7' },
  { name: 'One Light', shortName: 'One Light', id: 'one-light', category: 'light', foreground: '#4078F2', background: '#FAFAFA' },
  { name: 'Solarized Light', shortName: 'Solarized Light', id: 'solarized-light', category: 'light', foreground: '#268BD2', background: '#FDF6E3' },
]

const darkThemes = themes.filter((theme) => theme.category === 'dark')
const lightThemes = themes.filter((theme) => theme.category === 'light')

const apps = [
  {
    name: 'ARGVUS Removable Devices',
    image: argvusRemovableDevicesTaskbarImage,
    alt: 'ARGVUS Removable Devices na taskbar',
    text: t.appStorageText,
    carousel: [
      { image: argvusRemovableDevicesTaskbarImage, alt: 'ARGVUS Removable Devices na taskbar' },
      { image: argvusRemovableDevicesRofiImage, alt: 'ARGVUS Removable Devices no Rofi' },
    ],
  },
  {
    name: 'ARGVUS Taskbar Calendar',
    alt: 'ARGVUS Taskbar Calendar',
    text: t.appCalendarText,
    carousel: [
      { image: argvusCalendarImage, alt: 'ARGVUS Taskbar Calendar' },
      { image: argvusCalendarEventsImage, alt: 'ARGVUS Taskbar Calendar events' },
    ],
  },
  {
    name: 'ARGVUS Control Center',
    image: argvusControlCenterImage,
    alt: 'ARGVUS Control Center',
    text: t.appDefaultAppsText,
    features: t.controlCenterFeatures,
  },
]

const homeConfig = siteConfig.page_home
const contributionConfig = homeConfig.contributionLinks
const contributionEnabled = contributionConfig.enable
const contributionMode = contributionConfig.mode
const contributionStripeValues = contributionConfig.stripe
const contributionAmounts = Object.keys(contributionStripeValues).map(Number)
const parallaxEnabled = homeConfig.effects.parallax
const heroMatrixEnabled = homeConfig.effects.hero.matrix
---

<!doctype html>
<html lang={t.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="keywords" content={t.keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}${base}${isPT ? 'pt/' : ''}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ARGVUS" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={`${siteUrl}${base}${isPT ? 'pt/' : ''}`} />
    <meta property="og:image" content={`${siteUrl}${base}favicon.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${siteUrl}${base}favicon.png`} />
    <link rel="icon" type="image/png" href={base + 'favicon.png'} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'ARGVUS',
      applicationCategory: 'DesktopApplication',
      operatingSystem: 'Arch Linux',
      url: siteUrl,
      codeRepository: githubOrgUrl,
      description: t.description,
      keywords: t.keywords,
    })} />
    <script is:inline>
      // Aplica o tema antes do primeiro paint, sincronizado com a docs (chave do Starlight).
      ;(function () {
        var key = 'starlight-theme'
        var stored = localStorage.getItem(key)
        var light = matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : light
              ? 'light'
              : 'dark'
      })()
    </script>
    <noscript>
      <style>
        body[data-parallax-enabled='true'] [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      </style>
    </noscript>
  </head>
  <body data-pagefind-ignore data-parallax-enabled={parallaxEnabled ? 'true' : 'false'}>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={link('')}>
          <img class="brand-logotype" src={logotypeUrl} alt="" width={48} height={48} />
          <img class="brand-wordmark" src={argvusWordmarkUrl} alt="ARGVUS" width={178} height={20} />
          {isBeta && <span class="beta-badge">Beta</span>}
        </a>

        <nav class="site-nav" aria-label={t.navAria}>
          <div class="nav-links">
            <a class="nav-link" href={link('docs/introduction/')}><i class="fa-solid fa-book-open"></i>{t.navDocs}</a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button class="nav-link nav-dropdown-trigger" type="button" data-nav-dropdown-trigger>
                <i class="fa-solid fa-cube"></i>
                {t.navArch}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <div class="nav-dropdown-menu" data-nav-dropdown-menu hidden>
                <a class="nav-dropdown-item" href={link('docs/reference/package-matrix/')}><i class="fa-brands fa-linux"></i>{t.navArchArch}</a>
              </div>
            </div>
            <a class="nav-link" href={githubOrgUrl}><i class="fa-brands fa-github"></i>{t.github}</a>
            {contributionEnabled && <a class="nav-link nav-link-donate" href="#support"><i class="fa-solid fa-heart"></i>{t.navDonate}</a>}
          </div>

          <div class="lang-toggle" data-lang-toggle>
            <button
              class="lang-toggle-btn"
              type="button"
              data-lang-current
              aria-label={t.langAria}
              aria-haspopup="menu"
            >
              <span>{isPT ? 'PT' : 'EN'}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>

            <div class="lang-toggle-menu" data-lang-menu hidden>
              <a class="lang-option" href={base} aria-current={!isPT ? 'page' : undefined}>{t.langEnglish}</a>
              <a class="lang-option" href={base + 'pt/'} aria-current={isPT ? 'page' : undefined}>{t.langPortuguese}</a>
            </div>
          </div>

          <div class="theme-toggle" data-theme-toggle>
            <button
              class="theme-toggle-btn"
              type="button"
              data-theme-current
              aria-label={t.themeAria}
              aria-haspopup="menu"
            >
              <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
              </svg>
              <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
              <svg class="icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <path d="M8 21h8M12 17v4"></path>
              </svg>
            </button>

            <div class="theme-toggle-menu" data-theme-menu hidden>
              <button class="theme-option" type="button" data-theme-option="light" role="menuitemradio" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
                </svg>
                {t.themeLight}
              </button>
              <button class="theme-option" type="button" data-theme-option="dark" role="menuitemradio" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
                {t.themeDark}
              </button>
              <button class="theme-option" type="button" data-theme-option="system" role="menuitemradio" aria-checked="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                  <path d="M8 21h8M12 17v4"></path>
                </svg>
                {t.themeSystem}
              </button>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        {heroMatrixEnabled && (
        <div class="hero-code-bg matrix-bg" data-matrix-bg>
          <div class="matrix-column" style="left: 5%"><span>#!/usr/bin</span><span>set -e</span><span>SCRIPT_DIR</span><span>die()</span><span>printf</span><span>exit 1</span></div>
          <div class="matrix-column" style="left: 15%"><span>bash</span><span>pipefail</span><span>dirname</span><span>error</span><span>message</span><span>function</span></div>
          <div class="matrix-column" style="left: 25%"><span>ROOT_DIR</span><span>command -v</span><span>require</span><span>makepkg</span><span>shellcheck</span><span>validate</span></div>
          <div class="matrix-column" style="left: 35%"><span>SCRIPT_DIR</span><span>check</span><span>bash</span><span>make</span><span>tools</span><span>sh</span></div>
          <div class="matrix-column" style="left: 45%"><span>set -euo</span><span>die function</span><span>printf error</span><span>exit code</span><span>require cmd</span><span>validate</span></div>
          <div class="matrix-column" style="left: 55%"><span>#!/bin/bash</span><span>pipefail</span><span>dirname path</span><span>printf %s</span><span>command -v</span><span>shellcheck</span></div>
          <div class="matrix-column" style="left: 65%"><span>cd ROOT_DIR</span><span>SCRIPT_DIR</span><span>die()</span><span>require_command</span><span>makepkg</span><span>exit 1</span></div>
          <div class="matrix-column" style="left: 75%"><span>set -e</span><span>ROOT_DIR</span><span>bash -n</span><span>shellcheck</span><span>validate</span><span>tools/sh</span></div>
          <div class="matrix-column" style="left: 85%"><span>BASH_SOURCE</span><span>printf error</span><span>command -v</span><span>makepkg</span><span>shellcheck</span><span>exit</span></div>
          <div class="matrix-column" style="left: 95%"><span>dirname</span><span>bash</span><span>require</span><span>printf</span><span>tools</span><span>sh</span></div>
        </div>
        )}
        <div class="container">
          <div class="hero-badges">
            <span class="hero-badge hero-version-badge">{t.versionBadge}</span>
            <span class="hero-badge">Hyprland</span>
            <span class="hero-badge">Wayland</span>
            <span class="hero-badge">Arch Linux</span>
            <!-- <span class="hero-badge">Rust</span>
            <span class="hero-badge">GPL-3.0</span> -->
          </div>

          <h1>{t.heroTitle1} <span class="accent">{t.heroAccent}</span></h1>

          <p class="tagline">{t.heroTagline}</p>

          <p class="lead">{t.heroLead}</p>

          <div class="hero-actions">
            <a class="btn btn-primary" href={link('docs/getting-started/installation/')}>
              <i class="fa-solid fa-download"></i>{t.btnInstall}
            </a>
            <a class="btn btn-secondary" href={link('docs/introduction/')}>
              <i class="fa-solid fa-book-open"></i>{t.btnDocs}
            </a>
            <a class="btn btn-secondary" href={githubOrgUrl}>
              <i class="fa-brands fa-github"></i>{t.github}
            </a>
          </div>
        </div>
      </section>

      <!-- Screenshots -->
      <section class="screenshot-section">
        <div class="container">
          <div class="section-head screenshot-head" data-reveal>
            <span class="eyebrow">{t.screenshotsEyebrow}</span>
            <h2>{t.screenshotsTitle}</h2>
            <p>{t.screenshotsSubtitle}</p>
          </div>
          <div class="screenshot" data-reveal>
            <div class="screenshot-bar">
              <span class="address">argvus.desktop</span>
            </div>

            <div class="carousel" data-carousel>
              <div class="carousel-track">
                {slides.map((slide) => (
                  <figure
                    class="carousel-slide"
                    tabindex="0"
                    role="button"
                    aria-label={t.carouselOpen}
                    data-carousel-slide
                  >
                    <Image src={slide.image} alt={slide.alt ?? t.slideAlt(slide.name)} />
                    <figcaption class="carousel-caption">{slide.name}</figcaption>
                    <span class="carousel-zoom" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h6v6"></path>
                        <path d="M9 21H3v-6"></path>
                        <path d="M21 3l-7 7"></path>
                        <path d="M3 21l7-7"></path>
                      </svg>
                    </span>
                  </figure>
                ))}
              </div>

              <button class="carousel-btn prev" type="button" data-carousel-prev aria-label={t.carouselPrev}>
                ‹
              </button>
              <button class="carousel-btn next" type="button" data-carousel-next aria-label={t.carouselNext}>
                ›
              </button>

              <div class="carousel-dots">
                {slides.map((_, i) => (
                  <button class="carousel-dot" type="button" data-carousel-dot={i} aria-label={t.carouselDot(i + 1)}></button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- About -->
      <section class="section" id="about">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{t.aboutEyebrow}</span>
            <h2>{t.aboutTitle}</h2>
          </div>

          <div class="about-composition" data-about-animate data-reveal>
            <div class="about-parts">
              <div class="about-part">
                <span class="about-code">ARGV</span>
                <span class="about-label">{t.aboutArgv}</span>
              </div>
              <span class="about-plus">+</span>
              <div class="about-part">
                <span class="about-code">US</span>
                <span class="about-label">{t.aboutUs}</span>
              </div>
            </div>
            <div class="about-arrow">
              <svg viewBox="0 0 24 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="0" x2="12" y2="32"></line>
                <polyline points="6,26 12,34 18,26"></polyline>
              </svg>
            </div>
            <div class="about-result">
              <span class="about-name">ARGVUS</span>
            </div>
          </div>

          <div class="about-pronunciation" data-pronunciation data-reveal>
            <div class="about-pronunciation-copy">
              <span class="about-pronunciation-label">{t.aboutPronunciationLabel}</span>
              <p>{t.aboutPronunciationHint}</p>
            </div>
            <div class="about-pronunciation-controls">
              <label for="pronunciation-language">{t.aboutPronunciationLanguage}</label>
              <select id="pronunciation-language" data-pronunciation-select>
                <option value={argvusPronunciationEn} selected={!isPT}>{t.aboutPronunciationEnglish}</option>
                <option value={argvusPronunciationPt} selected={isPT}>{t.aboutPronunciationPortuguese}</option>
              </select>
              <audio
                controls
                preload="none"
                src={initialPronunciation}
                data-pronunciation-audio
                aria-label={t.aboutPronunciationAudio}
              ></audio>
            </div>
          </div>

          <div class="about-text" data-reveal>
            <p>{t.aboutText}</p>
            <p>{t.aboutText2}</p>
          </div>

          <p class="about-maintainer" data-reveal>
            {t.aboutMaintainer}{' '}
            <a href="https://github.com/williamcanin" target="_blank" rel="noopener noreferrer" aria-label={t.aboutMaintainerLink}>
              William C. Canin
            </a>
          </p>
        </div>
      </section>

      <!-- Components -->
      <section class="section" id="componentes">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{t.componentsEyebrow}</span>
            <h2>{t.componentsTitle}</h2>
            <p>{t.componentsSubtitle}</p>
          </div>

          <div class="feature-grid">
            {components.map((c) => (
              <article class="feature-card" data-reveal>
                <span class="mono">{c.name}</span>
                <h3>{c.name}</h3>
                <p>{t.componentDesc[c.key]}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Waybar -->
      <section class="section section-alt" id="waybar">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{t.waybarEyebrow}</span>
            <h2>{t.waybarTitle}</h2>
            <p>{t.waybarSubtitle}</p>
          </div>

          <div class="waybar-panel" data-reveal>
            <div class="waybar-visual">
              <div class="waybar-bar waybar-bar-top">
                <div class="waybar-mini group-a"></div>
                <div class="waybar-mini group-b"></div>
                <div class="waybar-mini group-c"></div>
              </div>
              <div class="waybar-screen">
                <span class="waybar-screen-hint">{t.waybarEyebrow}</span>
              </div>
              <div class="waybar-bar waybar-bar-bottom">
                <div class="waybar-mini group-a"></div>
                <div class="waybar-mini group-b"></div>
                <div class="waybar-mini group-c"></div>
              </div>
            </div>

            <div class="waybar-copy">
              <p class="waybar-lead">{t.waybarIntro}</p>
              <ul class="waybar-features">
                {t.waybarFeatures.map((f) => (
                  <li data-reveal><i class={f.icon}></i><span>{f.text}</span></li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Official apps -->
      <section class="section section-alt" id="apps">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{t.appsEyebrow}</span>
            <h2>{t.appsTitle}</h2>
            <p>{t.appsSubtitle}</p>
          </div>

          <div class="app-showcase">
            {apps.map((app) => (
              <article class="app-panel" data-reveal>
                <div class={`app-media${app.carousel ? ' has-carousel' : ''}`} data-reveal>
                  {app.carousel ? (
                    <div class="app-carousel" data-app-carousel>
                      {app.carousel.map((slide, i) => (
                        <div
                          class={`app-carousel-slide${i === 0 ? ' active' : ''}`}
                          data-preview
                          tabindex="0"
                          role="button"
                          aria-label={t.carouselOpen}
                        >
                          <Image src={slide.image} alt={slide.alt} />
                          <span class="app-zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M15 3h6v6"></path>
                              <path d="M9 21H3v-6"></path>
                              <path d="M21 3l-7 7"></path>
                              <path d="M3 21l7-7"></path>
