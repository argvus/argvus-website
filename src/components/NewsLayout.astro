---
import '@fontsource/ibm-plex-sans/400.css'
import '@fontsource/ibm-plex-sans/500.css'
import '@fontsource/ibm-plex-sans/600.css'
import '@fontsource/ibm-plex-sans/700.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/600.css'
import '@fortawesome/fontawesome-free/css/all.min.css'
import '../styles/landing.css'
import '../styles/news.css'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import siteConfig from '../site-config.json'
import versionInfo from '../../version.json'
import { newsLocales } from '../lib/news/posts'
import type { NewsLocale } from '../lib/news/messages'

interface Props {
  lang: NewsLocale
  title: string
  description: string
  newsPath?: string
}

const { lang, title, description, newsPath = '' } = Astro.props
const locale = newsLocales.find((item) => item.code === lang)
if (!locale) throw new Error(`Unsupported News locale: ${lang}`)
const isBeta = versionInfo.version.startsWith('0.')
const contributionEnabled = siteConfig.page_home.contributionLinks.enable
const base = import.meta.env.BASE_URL
const canonical = `https://argvus.github.io${base}${getCanonicalPath(lang, newsPath)}`
function getCanonicalPath(currentLang: string, path: string) {
  return `news/${currentLang === 'en' ? '' : `${currentLang}/`}${path ? `${path}/` : ''}`
}
---

<!doctype html>
<html lang={locale.htmlLang} dir={lang === 'ar' || lang === 'ur' ? 'rtl' : 'ltr'} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <title>{title} — ARGVUS</title>
    <meta property="og:type" content={newsPath ? 'article' : 'website'} />
    <meta property="og:title" content={`${title} — ARGVUS`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="news-site">
    <SiteHeader lang={lang} page="news" newsPath={newsPath} isBeta={isBeta} contributionEnabled={contributionEnabled} />
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
