{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "edit": {
      "*": "allow",
      "~/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny"
    }
  },
  "agent": {
    "news-translator": {
      "description": "Return translation JSON without using repository tools.",
      "mode": "primary",
      "permission": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
